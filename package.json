{
  "name": "document-compare",
  "version": "0.1.0-beta.3",
  "description": "智能文书审核与对比工具.",
  "author": "liuxu",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --dir",
    "release": "pnpm build && electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.31.0",
    "@napi-rs/canvas": "^0.1.100",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "5.7.284",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-pdf-embed": "^2.1.5",
    "vue-router": "^4.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@rushstack/eslint-patch": "^1.14.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.0.8",
    "vue-tsc": "^3.1.2"
  }
}
